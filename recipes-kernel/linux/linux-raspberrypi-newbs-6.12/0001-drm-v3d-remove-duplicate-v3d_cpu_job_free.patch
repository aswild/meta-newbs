From c7d303134644882d0235a0f65aec5a726ea867ee Mon Sep 17 00:00:00 2001
From: Allen Wild <allenwild93@gmail.com>
Date: Wed, 10 Jun 2026 21:40:06 -0400
Subject: [PATCH] drm/v3d: remove duplicate v3d_cpu_job_free

Looks like an untested conflict when backporting.

Fixes acd55ea40d03e06f20a9986363019e0e5173990e
---
 drivers/gpu/drm/v3d/v3d_submit.c | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/v3d/v3d_submit.c b/drivers/gpu/drm/v3d/v3d_submit.c
index f4dc1331b68f..2f1ebe5c76a6 100644
--- a/drivers/gpu/drm/v3d/v3d_submit.c
+++ b/drivers/gpu/drm/v3d/v3d_submit.c
@@ -158,14 +158,6 @@ v3d_job_free(struct kref *ref)
 	v3d_job_free_common(job, true);
 }
 
-static void
-v3d_cpu_job_free(struct kref *ref)
-{
-	struct v3d_job *job = container_of(ref, struct v3d_job, refcount);
-
-	v3d_job_free_common(job, false);
-}
-
 static void
 v3d_render_job_free(struct kref *ref)
 {
@@ -1498,4 +1490,4 @@ void v3d_submit_init(struct drm_device *dev) {
 	/* kick the clock so firmware knows we are using firmware clock interface */
 	v3d_clock_up_get(v3d);
 	v3d_clock_up_put(v3d);
-}
\ No newline at end of file
+}
-- 
2.54.0

